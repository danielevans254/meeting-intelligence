    {
      "parameters": {
        "jsCode": "const originals = $('Build Task Requests').all().filter(i => !i.json.skip_task).map(i => i.json);\nreturn $input.all().map((item,index) => { const original = originals[index]; const response = item.json.body ?? item.json; return {json:{...original,task:{system:original.routing.task_system,id:String(response.key || response.id || 'unknown'),url:response.self || null,status:'created'}}}; });"
