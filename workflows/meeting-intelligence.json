        "jsCode": "const data = $input.first().json;\nconst actionLines = data.summary.action_items.map((a,i) => (i+1)+'. '+a.title+(a.owner?' — '+a.owner:'')+(a.due_date?' (due '+a.due_date+')':'')).join('\\n');\nconst taskLines = data.tasks.map(t => '- '+t.system+': '+t.id).join('\\n');\nconst text = '*'+data.meeting.title+'*\\n'+data.summary.summary+'\\n\\n*Action items*\\n'+(actionLines || 'None')+'\\n\\n*Created tasks*\\n'+(taskLines || 'None');\nreturn [{json:{...data,notification_text:text}}];"
      },
