        "jsCode": "const base = $input.first().json;\nconst actions = base.summary.action_items;\nif (!actions.length) return [{json:{...base,skip_task:true,action_index:null,action:null}}];\nreturn actions.map((action,index) => ({json:{...base,skip_task:false,action_index:index,action,idempotency_key:base.event_id + ':' + index}}));"
      },
