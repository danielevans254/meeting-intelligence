  "name": "01 - Meeting Intelligence - Transcript to Tasks and Digest",
  "nodes": [
    {
      "parameters": {
        "content": "## Meeting intelligence\n\nWebhook → normalize → deterministic test or provider LLM → task fan-out → one digest.\n\nAll production writes sit behind `test_mode = false`. Imported workflows are inactive.",
        "width": 500,
        "height": 280,
        "color": 4
      },
      "id": "de1d6a60-9af1-4bb9-8ef4-e9cfe4de6652",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -760,
        -420
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-intelligence",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "63fedfea-8e35-4a91-9b72-8f7d2e3bf2cc",
      "name": "Meeting Transcript Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -720,
        0
      ],
      "webhookId": "ed35cc5c-24ed-4285-ba0e-ccca5dcc658a"
