    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst base = items[0];\nconst tasks = items.map(i => i.task).filter(Boolean);\nreturn [{json:{event_id:base.event_id,correlation_id:base.correlation_id,provider:base.provider,test_mode:base.test_mode,meeting:{id:base.meeting.id,title:base.meeting.title,recording_url:base.meeting.recording_url},routing:base.routing,summary:base.summary,tasks}}];"
      },
