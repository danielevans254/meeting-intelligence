    {
      "parameters": {
        "jsCode": "const normalize = function normalizeMeetingEnvelope(input) {\n  const src = input && typeof input === 'object' ? input : {};\n  const provider = String(src.provider || src.source || 'canonical').toLowerCase().replace('google-meet', 'google_meet');\n  const root = src.payload?.object || src.payload || src.meeting || src;\n  const sentences = src.transcript?.sentences || root.transcript?.sentences || src.sentences || root.sentences || [];\n  let transcript = src.transcript_text || root.transcript_text || src.transcript || root.transcript || '';\n  if (typeof transcript !== 'string') {\n    if (Array.isArray(sentences)) {\n      transcript = sentences.map((s) => {\n        if (typeof s === 'string') return s;\n        const speaker = s.speaker_name || s.speaker || s.name || 'Speaker';\n        return `${speaker}: ${s.text || s.content || ''}`;\n      }).join('\\n');\n    } else {\n      transcript = '';\n    }\n  }\n  if (!transcript && Array.isArray(root.segments)) {\n    transcript = root.segments.map((s) => `${s.speaker || 'Speaker'}: ${s.text || ''}`).join('\\n');\n  }\n  const participantsRaw = src.participants || root.participants || root.attendees || [];\n  const participants = (Array.isArray(participantsRaw) ? participantsRaw : []).map((p) => {\n    if (typeof p === 'string') return { name: p, email: null };\n    return { name: p.name || p.displayName || p.email || 'Unknown', email: p.email || p.mail || null };\n  });\n  const meetingId = String(src.event_id || src.meeting_id || root.id || root.uuid || root.meeting_id || '');\n  if (!meetingId) throw new Error('event_id or meeting identifier is required');\n  if (transcript.trim().length < 20) throw new Error('transcript must contain at least 20 characters');\n  const allowedProviders = ['canonical', 'fireflies', 'teams', 'meet', 'google_meet', 'zoom'];\n  if (!allowedProviders.includes(provider)) throw new Error(`unsupported meeting provider: ${provider}`);\n  const config = src.config || {};\n  const testMode = src.test_mode === true;\n  return {\n    event_id: meetingId,\n    correlation_id: String(src.correlation_id || meetingId),\n    provider,\n    test_mode: testMode,\n    received_at: src.received_at || new Date().toISOString(),\n    meeting: {\n      id: meetingId,\n      title: src.title || root.title || root.topic || root.subject || 'Untitled meeting',\n      started_at: src.started_at || root.start_time || root.startTime || null,\n      ended_at: src.ended_at || root.end_time || root.endTime || null,\n      recording_url: src.recording_url || root.recording_url || root.share_url || null,\n      participants,\n      transcript: transcript.trim(),\n    },\n    routing: {\n      llm_provider: String(config.llm_provider || src.llm_provider || 'gemini').toLowerCase(),\n      task_system: String(config.task_system || src.task_system || 'jira').toLowerCase(),\n      notification_system: String(config.notification_system || src.notification_system || 'slack').toLowerCase(),\n    },\n    mock_summary: src.mock_summary || null,\n  };\n};\nconst payload = $json.body ?? $json;\nconst result = normalize(payload);\nif (!['openai','anthropic','gemini'].includes(result.routing.llm_provider)) throw new Error('llm_provider must be openai, anthropic, or gemini');\nif (!['jira','airtable'].includes(result.routing.task_system)) throw new Error('task_system must be jira or airtable');\nif (!['slack','teams'].includes(result.routing.notification_system)) throw new Error('notification_system must be slack or teams');\nreturn [{ json: result }];"
      },
