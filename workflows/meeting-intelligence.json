    {
      "parameters": {
        "jsCode": "const base = $('Prepare Summary Prompt').first().json;\nconst response = $input.first().json;\nconst body = response.body ?? response;\nlet text;\nif (base.llm_provider === 'openai') text = body.choices?.[0]?.message?.content;\nelse if (base.llm_provider === 'anthropic') text = body.content?.find?.(x => x.type === 'text')?.text ?? body.content?.[0]?.text;\nelse text = body.candidates?.[0]?.content?.parts?.map?.(p => p.text || '').join('');\nif (!text) throw new Error('LLM response did not contain text');\ntext = String(text).replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'');\nlet summary;\ntry { summary = JSON.parse(text); } catch (error) { throw new Error('LLM returned invalid JSON: ' + error.message); }\nfor (const key of ['key_points','decisions','risks','action_items']) if (!Array.isArray(summary[key])) summary[key] = [];\nsummary.summary = String(summary.summary || '');\nsummary.action_items = summary.action_items.slice(0,50).map((a,i) => ({title:String(a.title || 'Action item ' + (i+1)),owner:a.owner ? String(a.owner) : null,due_date:a.due_date ? String(a.due_date) : null,priority:['low','medium','high'].includes(String(a.priority).toLowerCase()) ? String(a.priority).toLowerCase() : 'medium',description:String(a.description || '')}));\nreturn [{ json: { ...base, summary } }];"
      },
